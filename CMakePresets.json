{
	"version": 6,
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"binaryDir": "${sourceDir}/build/${presetName}"
		},
		{
			"name": "windows-x64",
			"hidden": true,
			"inherits": "base",
			"generator": "Visual Studio 18 2026",
			"architecture": "x64",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			}
		},
		{
			"name": "linux-x64",
			"hidden": true,
			"inherits": "base",
			"generator": "Ninja Multi-Config",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			}
		},
		{
			"name": "sdk2013-windows-x64",
			"displayName": "Source SDK 2013 (Windows x64)",
			"inherits": "windows-x64",
			"cacheVariables": { "VPHYSICS_GAME": "sdk2013" }
		},
		{
			"name": "gmod-windows-x64",
			"displayName": "Garry's Mod (Windows x64)",
			"inherits": "windows-x64",
			"cacheVariables": { "VPHYSICS_GAME": "gmod" }
		},
		{
			"name": "sdk2013-linux-x64",
			"displayName": "Source SDK 2013 (Linux x64)",
			"inherits": "linux-x64",
			"cacheVariables": { "VPHYSICS_GAME": "sdk2013" }
		},
		{
			"name": "gmod-linux-x64",
			"displayName": "Garry's Mod (Linux x64)",
			"inherits": "linux-x64",
			"cacheVariables": { "VPHYSICS_GAME": "gmod" }
		}
	],
	"buildPresets": [
		{ "name": "sdk2013-windows-x64-release", "configurePreset": "sdk2013-windows-x64", "configuration": "Release" },
		{ "name": "sdk2013-windows-x64-debug", "configurePreset": "sdk2013-windows-x64", "configuration": "Debug" },
		{ "name": "gmod-windows-x64-release", "configurePreset": "gmod-windows-x64", "configuration": "Release" },
		{ "name": "gmod-windows-x64-debug", "configurePreset": "gmod-windows-x64", "configuration": "Debug" },
		{ "name": "sdk2013-linux-x64-release", "configurePreset": "sdk2013-linux-x64", "configuration": "Release" },
		{ "name": "sdk2013-linux-x64-debug", "configurePreset": "sdk2013-linux-x64", "configuration": "Debug" },
		{ "name": "gmod-linux-x64-release", "configurePreset": "gmod-linux-x64", "configuration": "Release" },
		{ "name": "gmod-linux-x64-debug", "configurePreset": "gmod-linux-x64", "configuration": "Debug" }
	]
}
