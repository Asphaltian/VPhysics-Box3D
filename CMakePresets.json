{
	"version": 6,
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"binaryDir": "${sourceDir}/build/${presetName}"
		},
		{
			"name": "windows",
			"hidden": true,
			"inherits": "base",
			"generator": "Visual Studio 18 2026",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			}
		},
		{
			"name": "linux",
			"hidden": true,
			"inherits": "base",
			"generator": "Ninja Multi-Config",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "gcc-10",
				"CMAKE_CXX_COMPILER": "g++-10"
			},
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			}
		},
		{
			"name": "dedicated",
			"hidden": true,
			"cacheVariables": { "VPHYSICS_DEDICATED": "ON" }
		},
		{
			"name": "windows-x64",
			"displayName": "Windows x64",
			"inherits": "windows",
			"architecture": "x64"
		},
		{
			"name": "windows-x86",
			"displayName": "Windows x86",
			"inherits": "windows",
			"architecture": "Win32"
		},
		{
			"name": "linux-x64",
			"displayName": "Linux x64",
			"inherits": "linux"
		},
		{
			"name": "linux-x86",
			"displayName": "Linux x86",
			"inherits": "linux",
			"cacheVariables": {
				"CMAKE_C_FLAGS": "-m32 -march=pentium4 -mtune=core2 -msse2 -mfpmath=sse",
				"CMAKE_CXX_FLAGS": "-m32 -march=pentium4 -mtune=core2 -msse2 -mfpmath=sse"
			}
		},
		{
			"name": "dedicated-linux-x64",
			"displayName": "Dedicated Server (Linux x64)",
			"inherits": [ "linux-x64", "dedicated" ]
		},
		{
			"name": "dedicated-linux-x86",
			"displayName": "Dedicated Server (Linux x86)",
			"inherits": [ "linux-x86", "dedicated" ]
		}
	],
	"buildPresets": [
		{ "name": "windows-x64-release", "configurePreset": "windows-x64", "configuration": "Release" },
		{ "name": "windows-x64-debug", "configurePreset": "windows-x64", "configuration": "Debug" },
		{ "name": "windows-x86-release", "configurePreset": "windows-x86", "configuration": "Release" },
		{ "name": "windows-x86-debug", "configurePreset": "windows-x86", "configuration": "Debug" },
		{ "name": "linux-x64-release", "configurePreset": "linux-x64", "configuration": "Release" },
		{ "name": "linux-x64-debug", "configurePreset": "linux-x64", "configuration": "Debug" },
		{ "name": "linux-x86-release", "configurePreset": "linux-x86", "configuration": "Release" },
		{ "name": "linux-x86-debug", "configurePreset": "linux-x86", "configuration": "Debug" },
		{ "name": "dedicated-linux-x64-release", "configurePreset": "dedicated-linux-x64", "configuration": "Release" },
		{ "name": "dedicated-linux-x64-debug", "configurePreset": "dedicated-linux-x64", "configuration": "Debug" },
		{ "name": "dedicated-linux-x86-release", "configurePreset": "dedicated-linux-x86", "configuration": "Release" },
		{ "name": "dedicated-linux-x86-debug", "configurePreset": "dedicated-linux-x86", "configuration": "Debug" }
	]
}
